# Wick and the Content Builder. Without this the pages still load and every
# non-AI action works; generation reports that it isn't configured.
ANTHROPIC_API_KEY=
PORT=3000

# Each integration below is optional and independent. Leave one blank and the
# screen that uses it falls back to the sample data it shipped with.

# Home dashboard: leads started vs. goal on the pace dials.
PIPEDRIVE_API_TOKEN=

# CallRail channel screen. ACCOUNT_ID pins one account when the key can see
# several; blank means the first account the key can see.
CALLRAIL_API_KEY=
CALLRAIL_ACCOUNT_ID=

# Wick's find_job_photos tool.
COMPANYCAM_API_TOKEN=

# Constant Contact channel screen. OAuth, not a bare key: set these, then
# visit /auth/constantcontact/start once and approve access. REDIRECT_URI must
# match the one registered on the app; blank defaults to
# http://localhost:$PORT/auth/constantcontact/callback
CONSTANT_CONTACT_CLIENT_ID=
CONSTANT_CONTACT_CLIENT_SECRET=
CONSTANT_CONTACT_REDIRECT_URI=
